---
import BaseLayout from '@layouts/BaseLayout.astro'; import GalleryGrid from '@components/GalleryGrid.astro';
---
<BaseLayout title="Trabajos — Techno Barber" description="Acceso al perfil público de trabajos de Techno Barber."><section class="pb-12 pt-14 sm:pt-20"><p class="eyebrow">Perfil oficial</p><h1 class="mt-4 max-w-4xl text-5xl leading-[.9] tracking-[-.05em] sm:text-7xl">Antes de reservar, mirá el trabajo.</h1><p class="mb-10 mt-6 max-w-xl leading-relaxed text-zinc-400">El perfil público concentra los cortes publicados por el negocio.</p><GalleryGrid /></section></BaseLayout>
