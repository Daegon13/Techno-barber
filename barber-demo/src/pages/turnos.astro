---
import BaseLayout from "@layouts/BaseLayout.astro";
import barber from "@data/business";
import TurnosFlow from "@components/TurnosFlow.astro";

const title = `Turnos — ${barber.nombre}`;
const description = "Consultá disponibilidad por WhatsApp. Propuesta conceptual independiente.";
---

<BaseLayout title={title} description={description}>
  <section class="py-10">
    <div class="grid gap-6">
      <div>
        <TurnosFlow />
      </div>

      {barber.media.turnos && <aside class="overflow-hidden rounded-2xl border border-white/10 bg-white/5 shadow-soft">
        <img
          src={barber.media.turnos}
          alt="Reserva rápida desde el celular"
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </aside>}
    </div>
  </section>
</BaseLayout>
