---
import BaseLayout from '@layouts/BaseLayout.astro'; import Hero from '@components/Hero.astro'; import Section from '@components/Section.astro'; import ServiceCard from '@components/ServiceCard.astro'; import GalleryGrid from '@components/GalleryGrid.astro'; import LocationSection from '@components/LocationSection.astro'; import JourneySection from '@components/JourneySection.astro'; import barber from '@data/business'; import { buildWhatsAppLink, buildBookingMessage } from '@lib/whatsapp';
const wa = buildWhatsAppLink(barber.whatsapp, buildBookingMessage(barber.nombre)); const featured = barber.servicios.filter(s => s.destacado).slice(0, 4);
---
<BaseLayout title="Techno Barber — propuesta conceptual" description="Propuesta independiente de una web para consultar servicios y coordinar turnos con Techno Barber, Centro de Montevideo.">
  <Hero />
  <Section eyebrow="01 · Servicio" title="Corte" subtitle="Una opción clara para llegar a WhatsApp con el motivo de tu consulta definido."><div class="grid gap-5">{featured.map(s => <ServiceCard service={s} brand={barber.nombre} whatsapp={barber.whatsapp} />)}<aside class="flex flex-col justify-between gap-4 bg-white/[.045] p-5 sm:flex-row sm:items-center sm:px-7"><p><strong>¿Buscás otro servicio?</strong> <span class="text-zinc-400">Consultá opciones y precios por WhatsApp.</span></p><a href={wa} target="_blank" rel="noopener noreferrer" class="text-sm font-bold underline underline-offset-4">Hacer una consulta ↗</a></aside></div></Section>
  <Section eyebrow="02 · Trabajos" title="Antes de reservar, mirá el trabajo." subtitle="Sin imágenes atribuidas al local que no estén verificadas."><GalleryGrid limit={6} /></Section>
  <Section eyebrow="03 · Recorrido" title="Del interés al turno" subtitle="Un camino corto y comprensible: encontrar, elegir y consultar."><JourneySection /></Section>
  <Section eyebrow="04 · Llegá" title="Ubicación" subtitle="La información práctica, visible antes de salir."><LocationSection /></Section>
  <section class="noise my-8 overflow-hidden bg-white px-6 py-14 text-black sm:px-10 sm:py-20"><p class="eyebrow !text-zinc-600">Contacto directo</p><div class="relative mt-4 grid gap-8 md:grid-cols-[1fr_auto] md:items-end"><div><h2 class="max-w-3xl text-4xl leading-[.95] tracking-[-.05em] sm:text-6xl">¿Querés coordinar tu próximo turno?</h2><p class="mt-5 text-zinc-600">Consultá disponibilidad directamente con Techno Barber.</p></div><a href={wa} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-16 items-center justify-center rounded-sm bg-black px-7 font-bold text-white">Reservar turno <span aria-hidden="true" class="ml-3">↗</span></a></div></section>
</BaseLayout>
