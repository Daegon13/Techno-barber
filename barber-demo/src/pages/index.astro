---
import BaseLayout from '@layouts/BaseLayout.astro'; import Hero from '@components/Hero.astro'; import Section from '@components/Section.astro'; import BarbersSection from '@components/BarbersSection.astro'; import ServiceCard from '@components/ServiceCard.astro'; import Testimonials from '@components/Testimonials.astro'; import GalleryGrid from '@components/GalleryGrid.astro'; import LocationSection from '@components/LocationSection.astro'; import barber from '@data/business'; import { buildWhatsAppLink, buildBookingMessage } from '@lib/whatsapp';
const wa = buildWhatsAppLink(barber.whatsapp, buildBookingMessage(barber.nombre)); const featured = barber.servicios.filter(s => s.destacado).slice(0, 4);
---
<BaseLayout title="Techno Barber — propuesta conceptual" description="Propuesta independiente de una web para consultar servicios y coordinar turnos con Techno Barber, Centro de Montevideo.">
  <Hero />
  <Section eyebrow="01 · Elegí" title="Servicios" subtitle="Una propuesta clara, sin precios ni tiempos inventados. Consultá directamente por WhatsApp."><div class="grid gap-4">{featured.map(s => <ServiceCard service={s} brand={barber.nombre} whatsapp={barber.whatsapp} />)}</div></Section>
  <Section eyebrow="02 · Inspirate" title="Trabajos" subtitle="El contenido real vive en el perfil público del negocio."><GalleryGrid limit={6} /></Section>
  <Section eyebrow="03 · Confianza" title="Simple y directo" subtitle="Información pública verificable para decidir y contactar sin intermediarios."><div class="grid border-y border-white/15 sm:grid-cols-3"><div class="p-6 sm:p-8"><p class="display text-3xl">Centro</p><p class="mt-2 text-sm text-zinc-400">Sobre 18 de Julio, local 4.</p></div><div class="border-y border-white/15 p-6 sm:border-x sm:border-y-0 sm:p-8"><p class="display text-3xl">Directo</p><p class="mt-2 text-sm text-zinc-400">Consulta por WhatsApp con el local.</p></div><div class="p-6 sm:p-8"><p class="display text-3xl">Público</p><p class="mt-2 text-sm text-zinc-400">Trabajos disponibles en Instagram.</p></div></div></Section>
  {barber.testimonios.length > 0 && <Section title="Reseñas"><Testimonials items={barber.testimonios} /></Section>}{barber.barberos.length > 0 && <BarbersSection barberos={barber.barberos} />}
  <Section eyebrow="04 · Llegá" title="Ubicación"><LocationSection /></Section>
  <section class="my-8 bg-white px-6 py-12 text-black sm:px-10 sm:py-16"><p class="eyebrow !text-zinc-600">¿Coordinamos?</p><div class="mt-4 grid gap-7 md:grid-cols-[1fr_auto] md:items-end"><div><h2 class="text-4xl leading-none tracking-[-.04em] sm:text-6xl">Tu próximo corte empieza acá.</h2><p class="mt-4 text-zinc-600">Consultá disponibilidad. El local confirma el turno.</p></div><a href={wa} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-14 items-center justify-center rounded-sm bg-black px-6 font-bold text-white">Reservar turno <span aria-hidden="true" class="ml-3">↗</span></a></div></section>
</BaseLayout>
