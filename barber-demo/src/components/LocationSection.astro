---
import barber from '@data/business';
---
<div class="surface grid overflow-hidden md:grid-cols-[1.15fr_.85fr]">
  <div class="relative min-h-80 overflow-hidden bg-[radial-gradient(circle_at_43%_47%,#3a4147_0,transparent_8%),linear-gradient(145deg,#252b30,#0b0d0f_68%)]">
    <div aria-hidden="true" class="absolute inset-0 opacity-20" style="background-image:linear-gradient(27deg,transparent 47%,white 48%,white 49%,transparent 50%),linear-gradient(112deg,transparent 48%,white 49%,white 50%,transparent 51%);background-size:180px 150px"></div>
    <div class="absolute left-[43%] top-[47%] h-4 w-4 -translate-x-1/2 -translate-y-1/2 rounded-full border-4 border-white bg-black shadow-[0_0_0_10px_rgba(255,255,255,.1)]"></div>
    <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between"><span class="text-xs uppercase tracking-[.16em] text-zinc-300">Centro · Montevideo</span><span class="display text-5xl text-white/10">18J</span></div>
  </div>
  <div class="flex flex-col justify-center p-7 sm:p-10">
    <p class="eyebrow">Dónde encontrarnos</p><p class="display mt-4 text-3xl leading-tight">Centro de Montevideo<br/><span class="mt-3 block text-zinc-400">Av. 18 de Julio 959 · Local 4</span></p>
    <p class="mt-4 text-sm text-zinc-400">Consultá al local antes de ir para coordinar disponibilidad.</p>
    <div class="mt-7 grid gap-3"><a href={barber.maps} target="_blank" rel="noopener noreferrer" class="button-primary">Cómo llegar <span aria-hidden="true" class="ml-3">↗</span></a><a href={`tel:+${barber.whatsapp}`} class="button-secondary">Llamar al {barber.telefono}</a></div>
  </div>
</div>
