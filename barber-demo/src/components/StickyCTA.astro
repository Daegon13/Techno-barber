---
import { buildWhatsAppLink, buildBookingMessage } from '@lib/whatsapp';
const { brand, whatsapp } = Astro.props;
const href = buildWhatsAppLink(whatsapp, buildBookingMessage(brand));
---
<div class="fixed inset-x-0 bottom-0 z-40 md:hidden">
  <div class="safe-bottom border-t border-white/15 bg-[#0b0d0f]/95 px-3 pt-3 backdrop-blur-xl">
    <a href={href} target="_blank" rel="noopener noreferrer" class="button-primary w-full">Reservar turno por WhatsApp <span aria-hidden="true" class="ml-2">↗</span></a>
  </div>
</div>
