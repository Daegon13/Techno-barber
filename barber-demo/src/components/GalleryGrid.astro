---
import barber from '@data/business';
const { limit = barber.galeria.length } = Astro.props;
---
{barber.galeria.length > 0 ? <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {barber.galeria.slice(0, limit).map(item => <figure class="overflow-hidden bg-zinc-900">
    <img src={item.imagen} alt={item.alt} class="aspect-square w-full object-cover" loading="lazy" />
    <figcaption class="p-4 text-sm"><a href={item.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">Ver publicación original</a></figcaption>
  </figure>)}
</div> : <div class="surface relative isolate overflow-hidden px-6 py-12 sm:px-12 sm:py-16">
  <div aria-hidden="true" class="absolute -right-16 -top-24 h-80 w-80 rounded-full border-[4rem] border-white/[.035]"></div>
  <div class="relative grid gap-10 md:grid-cols-[1fr_.7fr] md:items-end"><div><p class="eyebrow">@techno.barber</p><h3 class="display mt-4 max-w-3xl text-4xl leading-[.95] tracking-[-.045em] sm:text-6xl">Antes de reservar, mirá el trabajo.</h3>
  <p class="mt-6 max-w-xl leading-relaxed text-zinc-300">El perfil público concentra los cortes publicados por el negocio.</p></div>
  <div class="md:justify-self-end"><div aria-hidden="true" class="mb-5 flex items-center gap-3 text-zinc-500"><span class="grid h-12 w-12 place-items-center rounded-full border border-white/20 text-xl">◎</span><span class="h-px w-24 bg-gradient-to-r from-white/40 to-transparent"></span></div><a href={barber.instagram} target="_blank" rel="noopener noreferrer" class="button-primary w-full sm:w-auto">Ver trabajos en Instagram <span aria-hidden="true" class="ml-3">↗</span></a></div></div>
</div>}
