---
import { formatUYU, buildWhatsAppLink, buildBookingMessage } from '@lib/whatsapp';
import type { Servicio } from '@lib/types';
type Props = { service: Servicio; brand: string; whatsapp: string };
const { service, brand, whatsapp } = Astro.props;
const href = buildWhatsAppLink(whatsapp, buildBookingMessage(brand, service.nombre));
---
<article class="surface group overflow-hidden md:grid md:grid-cols-[1.08fr_.92fr]">
  {service.imagen ? <figure class="relative min-h-72 overflow-hidden md:min-h-[30rem]">
    <img src={service.imagen} alt={service.alt ?? service.nombre} class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.025]" loading="lazy" />
    <figcaption class="absolute bottom-3 left-3 bg-black/75 px-2 py-1 text-xs text-zinc-300">Imagen ilustrativa</figcaption>
  </figure> : <div aria-hidden="true" class="relative min-h-44 overflow-hidden bg-[linear-gradient(135deg,#1e2327,#090b0d_65%)]">
    <span class="display absolute -bottom-7 -left-2 text-[9rem] leading-none text-white/[.04]">01</span><span class="absolute right-8 top-8 h-24 w-px rotate-45 bg-white/30"></span>
  </div>}
  <div class="flex flex-col justify-center p-6 sm:p-9">
    <p class="eyebrow">Servicio disponible</p>
    <h3 class="display mt-3 text-4xl tracking-[-.04em]">{service.nombre}</h3>
    <p class="mt-4 text-zinc-400">{service.descripcion}</p>
    {service.precio != null && <p class="mt-3 font-semibold">{formatUYU(service.precio)}</p>}
    {service.duracion != null && <p class="mt-1 text-sm text-zinc-400">{service.duracion} min</p>}
    <div class="mt-7 flex flex-col gap-3 sm:flex-row">
      <a href={href} target="_blank" rel="noopener noreferrer" class="button-primary">Reservar turno</a>
      <a href={`/turnos?servicio=${encodeURIComponent(service.id)}`} class="button-secondary">Elegir preferencia</a>
    </div>
  </div>
</article>
