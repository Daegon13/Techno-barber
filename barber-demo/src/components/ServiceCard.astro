---
import { formatUYU, buildWhatsAppLink, buildBookingMessage } from '@lib/whatsapp';
import type { Servicio } from '@lib/types';
type Props = { service: Servicio; brand: string; whatsapp: string };
const { service, brand, whatsapp } = Astro.props;
const href = buildWhatsAppLink(whatsapp, buildBookingMessage(brand, service.nombre));
---
<article class="rounded-2xl border border-white/10 bg-white/5 overflow-hidden shadow-soft">
  {service.imagen && <img src={service.imagen} alt={service.alt ?? service.nombre} class="h-44 w-full object-cover" loading="lazy" />}
  <div class="p-5">
    <h3 class="text-xl font-semibold">{service.nombre}</h3>
    <p class="mt-2 text-base text-zinc-300">{service.descripcion}</p>
    {service.precio != null && <p class="mt-3 font-semibold">{formatUYU(service.precio)}</p>}
    {service.duracion != null && <p class="mt-1 text-sm text-zinc-300">{service.duracion} min</p>}
    <div class="mt-5 flex flex-col sm:flex-row gap-3">
      <a href={href} target="_blank" rel="noopener noreferrer" class="rounded-xl bg-cyanA-500 px-4 py-3 text-center font-semibold text-ink-950">Reservar turno</a>
      <a href={`/turnos?servicio=${encodeURIComponent(service.id)}`} class="rounded-xl border border-white/20 px-4 py-3 text-center">Elegir preferencia</a>
    </div>
  </div>
</article>
