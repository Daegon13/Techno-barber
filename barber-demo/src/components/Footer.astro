---
import barber from '@data/business';
const developerMessage = encodeURIComponent('Hola Diego, vi la propuesta web para Techno Barber y me gustaría conversar.');
---
<footer class="border-t border-white/10 bg-black/30">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid gap-9 sm:grid-cols-2 sm:items-start">
      <div><p class="display text-lg">Techno Barber</p><p class="mt-2 max-w-sm text-sm leading-relaxed text-zinc-400">{barber.direccion}, {barber.ciudad}.</p><a href={barber.instagram} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block text-sm underline underline-offset-4">Instagram oficial</a></div>
      <div class="border-l border-white/15 pl-5 sm:justify-self-end"><p class="text-sm font-semibold">¿Te interesa esta propuesta?</p><p class="mt-2 text-xs text-zinc-500">Contacto del desarrollador · separado de las reservas</p><div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm"><a href={`https://wa.me/59897316092?text=${developerMessage}`} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4">WhatsApp de Diego</a><a href="mailto:damgmarin13@gmail.com" class="underline underline-offset-4">Correo</a></div></div>
    </div>
    <p class="mt-10 border-t border-white/10 pt-5 text-xs leading-relaxed text-zinc-500">Propuesta conceptual independiente para Techno Barber. No es el sitio oficial.</p>
  </div>
</footer>
