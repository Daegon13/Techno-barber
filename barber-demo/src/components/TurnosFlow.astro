---
import barber from '@data/business';
import { buildWhatsAppLink, buildBookingMessage } from '@lib/whatsapp';
const href = buildWhatsAppLink(barber.whatsapp, buildBookingMessage(barber.nombre));
---
<section id="turnosConfig" data-brand={barber.nombre} data-whatsapp={barber.whatsapp} class="rounded-2xl border border-white/10 bg-white/5 p-5 md:p-6 shadow-soft">
  <h1 class="text-3xl font-semibold">Reservar turno</h1>
  <p class="mt-3 text-base text-zinc-300">Consultá disponibilidad directamente o agregá tus preferencias al mensaje.</p>
  <form id="bookingPreferences" class="mt-6 grid gap-5" aria-label="Preferencias de turno">
    <label class="grid gap-2">Servicio
      <select id="bookingService" class="rounded-xl border border-white/20 bg-ink-900 p-3">
        <option value="">Consultar al local</option>
        {barber.servicios.map(s => <option value={s.id} data-name={s.nombre}>{s.nombre}</option>)}
      </select>
    </label>
    <label class="grid gap-2">Fecha preferida (opcional)
      <input id="bookingDate" type="date" class="rounded-xl border border-white/20 bg-ink-900 p-3" />
    </label>
    <label class="grid gap-2">Franja preferida (opcional)
      <select id="bookingPeriod" class="rounded-xl border border-white/20 bg-ink-900 p-3">
        <option value="">Sin preferencia</option><option value="mañana">Mañana</option><option value="tarde">Tarde</option>
      </select>
    </label>
    <p id="bookingError" role="status" class="text-amber-200"></p>
  </form>
  <p id="previewMsg" class="mt-5 text-base text-zinc-300" aria-live="polite">{buildBookingMessage(barber.nombre)}</p>
  <a id="waCta" href={href} target="_blank" rel="noopener noreferrer" class="mt-5 inline-block rounded-xl bg-cyanA-500 px-5 py-4 text-center font-semibold text-ink-950">Reservar turno</a>
  <p class="mt-4 text-sm text-zinc-300">Las preferencias no indican disponibilidad. El turno queda confirmado cuando te responde el local.</p>
</section>
<script>
  import '../scripts/turnos';
</script>
