---
type Props = { currentPath?: string };
const { currentPath = '/' } = Astro.props as Props;
const links = [['/', 'Inicio'], ['/servicios', 'Servicios'], ['/galeria', 'Trabajos'], ['/ubicacion', 'Ubicación']];
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[#080a0c]/90 backdrop-blur-xl">
  <div class="mx-auto flex h-[4.5rem] max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="display flex items-center gap-2 text-base tracking-[-.04em]" aria-label="Techno Barber, inicio">
      <span class="inline-block h-2.5 w-2.5 bg-white"></span> Techno Barber
    </a>
    <nav aria-label="Navegación principal" class="hidden items-center gap-7 md:flex">
      {links.map(([href, label]) => <a href={href} aria-current={currentPath === href ? 'page' : undefined} class:list={["text-sm font-medium text-zinc-400 transition hover:text-white", currentPath === href && "text-white"]}>{label}</a>)}
      <a href="/turnos" class="button-primary !min-h-0 !px-5 !py-2.5 text-sm">Reservar turno</a>
    </nav>
    <details class="group relative md:hidden" id="mobileMenu">
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded border border-white/20" aria-label="Abrir menú"><span class="text-xl leading-none">☰</span></summary>
      <nav aria-label="Navegación móvil" class="absolute right-0 mt-3 grid w-64 gap-1 rounded border border-white/15 bg-[#101214] p-3 shadow-2xl">
        {links.map(([href, label]) => <a href={href} class="rounded px-4 py-3 text-base hover:bg-white/10">{label}</a>)}
        <a href="/turnos" class="mt-2 rounded bg-white px-4 py-3 text-center font-bold text-black">Reservar turno</a>
      </nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>('#mobileMenu');
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => menu.removeAttribute('open')));
  document.addEventListener('click', event => { if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.removeAttribute('open'); });
</script>
