---
const { title, subtitle, eyebrow } = Astro.props;
---
<section class="border-t border-white/10 py-14 sm:py-20">
  <div class="mb-8 grid gap-3 md:grid-cols-[1fr_1fr] md:items-end">
    <div>{eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}<h2 class="text-3xl leading-none tracking-[-.04em] sm:text-5xl">{title}</h2></div>
    {subtitle && <p class="max-w-xl text-base leading-relaxed text-zinc-400 md:justify-self-end">{subtitle}</p>}
  </div>
  <slot />
</section>
