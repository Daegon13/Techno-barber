---
import '@styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import StickyCTA from '@components/StickyCTA.astro';
import SiteBackground from '@components/SiteBackground.astro';
import barber from '@data/business';
type Props = { title: string; description: string };
const { title, description } = Astro.props;
const url = new URL(Astro.request.url);
const canonical = Astro.site ? new URL(url.pathname, Astro.site).href : undefined;
const og = barber.media.og && Astro.site ? new URL(barber.media.og, Astro.site).href : undefined;
---
<!doctype html>
<html lang="es-UY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    {canonical && <link rel="canonical" href={canonical} />}
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {og && <meta property="og:image" content={og} />}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
    <meta name="theme-color" content="#07090B" />
  </head>
  <body class="text-zinc-100">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-0 focus:z-[100] focus:bg-black focus:p-4">Saltar al contenido</a>
    <SiteBackground />
    <Header currentPath={url.pathname.replace(/\/$/, '') || '/'} />
    <main id="contenido" class="mx-auto w-full max-w-7xl px-4 pb-28 pt-[4.5rem] sm:px-6 lg:px-8"><slot /></main>
    <Footer />
    <StickyCTA brand={barber.nombre} whatsapp={barber.whatsapp} />
  </body>
</html>
