---
import BaseLayout from "@layouts/BaseLayout.astro";
import barber from "@data/barber.json";
import TurnosFlow from "@components/TurnosFlow.astro";
import { getSafeAgendaHref, isExternalHref } from "@lib/whatsapp";

const title = `Reservas — ${barber.nombre}`;
const description = `Demo conceptual del flujo de reserva de ${barber.nombre}, preparado para complementar WhatsApp y la agenda online actual.`;
const agendaHref = getSafeAgendaHref(barber.agendaUrl, barber.agendaEsPlaceholder);
const agendaIsExternal = isExternalHref(agendaHref);
---

<BaseLayout title={title} description={description}>
  <section class="py-10">
    <div class="mb-6 border border-amber-200/20 bg-amber-100/[.04] px-5 py-4">
      <p class="text-xs font-bold uppercase tracking-[.18em] text-amber-100/80">Flujo demostrativo</p>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-stone-400">Esta pantalla permite explorar cómo se armaría una intención de reserva. No confirma disponibilidad ni genera un turno real; la coordinación final seguiría ocurriendo por WhatsApp o en la agenda externa vigente.</p>
    </div>
    <div class="grid gap-6 lg:grid-cols-[1.2fr_.8fr]">
      <TurnosFlow />

      <aside class="overflow-hidden rounded-2xl border border-white/10 bg-white/5 shadow-soft">
        <img src={barber.media.turnos} alt="Imagen conceptual de una reserva rápida desde el celular" class="h-full w-full object-cover" loading="lazy" decoding="async" />
        <div class="p-5">
          <p class="text-sm leading-relaxed text-zinc-400">Una capa propia puede preparar mejor la consulta y luego derivarla a la agenda online actual. No busca reemplazarla.</p>
          <a href={agendaHref} target={agendaIsExternal ? "_blank" : undefined} rel={agendaIsExternal ? "noopener noreferrer" : undefined} class="mt-4 inline-flex rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm font-semibold text-zinc-100 hover:bg-white/10 transition">
            {barber.agendaEsPlaceholder ? "Agenda online a conectar" : barber.ctas.secundario}
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
