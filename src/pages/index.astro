---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import ServiceCard from "@components/ServiceCard.astro";
import barber from "@data/barber.json";
import { buildWhatsAppLink } from "@lib/whatsapp";
const choices = [
  { title: 'Corte', detail: 'Ver disponibilidad en la agenda oficial', href: barber.agendaAuto },
  { title: 'Corte + Barba', detail: 'Ver disponibilidad en la agenda oficial', href: barber.agendaAuto },
  { title: 'Barba', detail: 'Ver disponibilidad en la agenda oficial', href: barber.agendaAuto },
  { title: 'Tengo una referencia', detail: 'Compartirla antes por WhatsApp', href: buildWhatsAppLink(barber.whatsapp, barber.mensajes.referencia) }
];
---
<BaseLayout title={barber.seo.title} description={barber.seo.description}>
  <Hero />
  <section aria-label="Conveniencia" class="border-y border-white/10 bg-[#0b0e0e]"><div class="mx-auto grid max-w-7xl divide-y divide-white/10 px-5 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-8">{[["En el Centro",barber.direccion],["Horarios amplios","Lunes a viernes hasta las 20:00"],["Agenda oficial conectada","Disponibilidad y reserva en el sistema actual"]].map(([a,b])=><div class="py-6 sm:px-7"><p class="text-[10px] font-bold uppercase tracking-[.2em] text-cyan-300">{a}</p><p class="mt-2 text-sm text-zinc-300">{b}</p></div>)}</div></section>

  <section class="px-5 py-20 sm:px-8"><div class="mx-auto max-w-6xl"><p class="eyebrow">Decisión rápida</p><h2 class="section-title mt-3">¿Qué querés hacer hoy?</h2><p class="mt-5 max-w-2xl text-zinc-400">Elegí una opción. Te llevamos a la agenda oficial o a WhatsApp si necesitás compartir una referencia.</p><div class="mt-10 grid gap-3 sm:grid-cols-2">{choices.map((choice,index)=><a href={choice.href} target="_blank" rel="noopener noreferrer" class="group flex min-h-40 flex-col justify-between border border-white/15 p-6 transition hover:border-cyan-300 hover:bg-cyan-300/[.04]"><span class="text-xs font-black text-cyan-300">0{index+1}</span><div><h3 class="text-2xl font-black">{choice.title}</h3><p class="mt-2 text-sm text-zinc-400">{choice.detail} ↗</p></div></a>)}</div></div></section>

  <section id="servicios" class="scroll-mt-24 bg-[#0b0e0e] px-5 py-20 sm:px-8"><div class="mx-auto max-w-6xl"><p class="eyebrow">Servicios actuales</p><div class="mt-3 grid gap-5 lg:grid-cols-2 lg:items-end"><h2 class="section-title">Lo esencial, claro antes de reservar.</h2><p class="max-w-xl text-zinc-400 lg:justify-self-end">Precios y tiempos públicos, en una lectura rápida. Elegí tu servicio y seguí hacia la agenda oficial.</p></div><div class="mt-10">{barber.servicios.map(service => <ServiceCard service={service}/>)}</div><p class="mt-5 text-xs text-zinc-500">Disponibilidad y valores finales se confirman en la agenda.</p></div></section>

  <section id="galeria" class="scroll-mt-24 px-5 py-20 sm:px-8"><div class="mx-auto max-w-6xl"><div class="grid gap-8 lg:grid-cols-[.8fr_1.2fr]"><div><p class="eyebrow">Vidriera de trabajos</p><h2 class="section-title mt-3">El resultado entra por los ojos.</h2><p class="mt-5 text-zinc-400">Esta sección está preparada para mostrar trabajos reales cuando el equipo autorice y publique su material.</p><a href={barber.instagram} target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex bg-cyan-300 px-6 py-4 font-bold text-black">Ver trabajos en Instagram ↗</a></div><div class="grid grid-cols-2 gap-3">{barber.galeria.map((item,index)=><figure class:list={["relative overflow-hidden",index===0&&"row-span-2"]}><img src={item.after} alt="Imagen conceptual de estructura editorial" class:list={["w-full object-cover",index===0?"h-full min-h-96":"h-48"]}/></figure>)}</div></div><p class="mt-5 border-l border-cyan-300 pl-4 text-xs leading-relaxed text-zinc-500">Nota de transparencia: las imágenes de esta demo son referencias conceptuales; no representan trabajos ni el local de Techno Barber.</p></div></section>

  <section id="reservar" class="scroll-mt-24 bg-[#0b0e0e] px-5 py-20 sm:px-8"><div class="mx-auto max-w-6xl"><p class="eyebrow">Agenda oficial</p><h2 class="section-title mt-3">Tu turno, en el sistema que ya conocés.</h2><div class="mt-10 grid gap-4 md:grid-cols-2"><a href={barber.agendaAuto} target="_blank" rel="noopener noreferrer" class="border border-white/15 p-7 hover:border-cyan-300"><span class="text-xs text-cyan-300">01</span><h3 class="mt-8 text-2xl font-bold">Primera hora disponible</h3><p class="mt-3 text-sm text-zinc-400">Encontrá el próximo turno en la agenda oficial.</p><span class="mt-8 inline-block font-bold">Abrir agenda ↗</span></a><a href={barber.agendaProfesional} target="_blank" rel="noopener noreferrer" class="border border-white/15 p-7 hover:border-cyan-300"><span class="text-xs text-cyan-300">02</span><h3 class="mt-8 text-2xl font-bold">Elegir profesional</h3><p class="mt-3 text-sm text-zinc-400">Consultá la disponibilidad por profesional.</p><span class="mt-8 inline-block font-bold">Elegir profesional ↗</span></a></div></div></section>

  <section id="ubicacion" class="scroll-mt-24 px-5 py-20 sm:px-8"><div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[.9fr_1.1fr]"><div><p class="eyebrow">Ubicación</p><h2 class="section-title mt-3">En el Centro, fácil de ubicar.</h2><p class="mt-6 text-xl font-bold">{barber.direccion}</p><div class="mt-7">{barber.horarios.map(h=><div class="flex justify-between border-b border-white/10 py-3 text-sm"><span class="text-zinc-400">{h.dias}</span><strong>{h.horas}</strong></div>)}</div><div class="mt-7 flex flex-wrap gap-4 text-sm font-bold"><a href={barber.maps} target="_blank" rel="noopener noreferrer" class="text-cyan-300">Cómo llegar ↗</a><a href={barber.opiniones} target="_blank" rel="noopener noreferrer">Opiniones públicas ↗</a></div></div><figure class="relative min-h-96 overflow-hidden"><img src={barber.media.location} alt="Referencia conceptual de ubicación urbana" class="absolute inset-0 h-full w-full object-cover grayscale"/></figure></div></section>
</BaseLayout>
