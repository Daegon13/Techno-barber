---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import Section from "@components/Section.astro";
import BarbersSection from "@components/BarbersSection.astro";
import ServiceCard from "@components/ServiceCard.astro";
import CommercialLayer from "@components/CommercialLayer.astro";
import barber from "@data/barber.json";
import { buildBookingMessage, getSafeAgendaHref, getSafeWhatsAppHref, isExternalHref } from "@lib/whatsapp";

const ctaPrimary = getSafeWhatsAppHref(barber.whatsapp, buildBookingMessage(barber.mensajes.whatsappBase), barber.whatsappEsPlaceholder);
const ctaAgenda = getSafeAgendaHref(barber.agendaUrl, barber.agendaEsPlaceholder);
const primaryIsExternal = isExternalHref(ctaPrimary);
const agendaIsExternal = isExternalHref(ctaAgenda);
const featured = barber.servicios.filter((service) => service.popular).slice(0, 4);
const title = barber.seo.title;
const description = barber.seo.description;
const experience = [
  { number: "01", title: "Atención privada", text: "Un turno, un profesional y el foco puesto en vos." },
  { number: "02", title: "Técnica y criterio", text: "Cada servicio se adapta a tu estilo, rostro y rutina." },
  { number: "03", title: "Sin esperas", text: "Agenda previa para respetar tu tiempo y el nuestro." }
];
---

<BaseLayout title={title} description={description}>
  <Hero />

  <section class="border-x border-b border-white/10 bg-[#0c0c0b]">
    <div class="grid divide-y divide-white/10 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {[
        ["Experiencia", "Estudio privado"],
        ["Modalidad", "Agenda previa"],
        ["Ubicación", `${barber.barrio}, ${barber.ciudad}`]
      ].map(([label, value]) => (
        <div class="px-6 py-5 sm:px-8">
          <div class="text-[9px] font-bold uppercase tracking-[.2em] text-stone-600">{label}</div>
          <div class="mt-1 text-sm font-semibold text-stone-200">{value}</div>
        </div>
      ))}
    </div>
  </section>

  <Section title={barber.contenido.experienciaTitulo} subtitle={barber.contenido.experienciaBajada}>
    <div class="grid border-y border-white/10 sm:grid-cols-3 sm:divide-x sm:divide-white/10">
      {experience.map((item) => (
        <article class="border-b border-white/10 px-1 py-7 last:border-b-0 sm:border-b-0 sm:px-7 sm:py-8">
          <span class="text-[10px] font-bold tracking-[.2em] text-amber-100/60">{item.number}</span>
          <h3 class="mt-4 text-lg font-semibold text-stone-100">{item.title}</h3>
          <p class="mt-2 max-w-xs text-sm leading-relaxed text-stone-500">{item.text}</p>
        </article>
      ))}
    </div>
  </Section>

  <section id="servicios" class="scroll-mt-24 border-y border-white/10 bg-black/20 py-14 sm:py-20">
    <div class="mb-8 flex flex-col justify-between gap-5 sm:mb-10 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <span class="block h-px w-10 bg-amber-200/60"></span>
        <h2 class="mt-3 text-3xl font-semibold tracking-[-.035em] text-stone-50 sm:text-4xl">Servicios destacados.</h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-stone-400 sm:text-base">{barber.contenido.serviciosBajada}</p>
      </div>
      <a href="/servicios" class="text-xs font-bold uppercase tracking-[.14em] text-stone-300 transition hover:text-amber-100">Ver todos <span aria-hidden="true">↗</span></a>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {featured.map((service) => (
        <ServiceCard service={service} brand={barber.nombre} whatsapp={barber.whatsapp} />
      ))}
    </div>
  </section>

  <BarbersSection barberos={barber.barberos} />

  <CommercialLayer />

  <section class="relative overflow-hidden border border-white/10 bg-[#11110f]">
    <div aria-hidden="true" class="absolute right-0 top-0 h-full w-1/2 bg-[radial-gradient(circle_at_top_right,rgba(177,143,86,.12),transparent_65%)]"></div>
    <div class="relative grid gap-10 px-6 py-10 sm:px-10 sm:py-14 lg:grid-cols-[1fr_auto] lg:items-center">
      <div class="max-w-2xl">
        <div class="text-[10px] font-bold uppercase tracking-[.24em] text-amber-100/70">Reserva demostrativa</div>
        <h2 class="mt-4 text-3xl font-semibold tracking-[-.04em] text-stone-50 sm:text-4xl">{barber.contenido.reservaTitulo}</h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-stone-400 sm:text-base">{barber.contenido.reservaBajada}</p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
        <a href={ctaPrimary} target={primaryIsExternal ? "_blank" : undefined} rel={primaryIsExternal ? "noopener noreferrer" : undefined} class="inline-flex min-h-14 items-center justify-center bg-stone-100 px-7 text-sm font-bold text-stone-950 transition hover:bg-amber-100">
          {barber.whatsappEsPlaceholder ? "Explorar reserva" : barber.ctas.principal}
        </a>
        <a href={ctaAgenda} target={agendaIsExternal ? "_blank" : undefined} rel={agendaIsExternal ? "noopener noreferrer" : undefined} class="inline-flex min-h-14 items-center justify-center border border-white/15 px-7 text-sm font-semibold text-stone-300 transition hover:bg-white/5 hover:text-stone-100">
          {barber.agendaEsPlaceholder ? "Agenda online a conectar" : barber.ctas.secundario}
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="grid gap-8 lg:grid-cols-[.75fr_1.25fr] lg:items-stretch">
      <div class="flex flex-col justify-between">
        <div>
          <span class="block h-px w-10 bg-amber-200/60"></span>
          <h2 class="mt-3 text-3xl font-semibold tracking-[-.035em] text-stone-50 sm:text-4xl">Donde la ciudad baja el ritmo.</h2>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-stone-400 sm:text-base">{barber.contenido.ubicacionBajada}</p>
          <p class="mt-5 text-sm font-semibold text-stone-200">{barber.direccion}<br /><span class="font-normal text-stone-500">{barber.barrio} · {barber.ciudad}</span></p>
        </div>
        <div class="mt-8 border-t border-white/10 pt-4">
          {barber.horarios.map((horario) => (
            <div class="flex justify-between gap-4 py-2 text-xs">
              <span class="text-stone-500">{horario.dias}</span>
              <span class="font-semibold text-stone-300">{horario.horas}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="relative min-h-72 overflow-hidden border border-white/10 sm:min-h-[430px]">
        <img src={barber.media.location} alt="Imagen conceptual de la ubicación del estudio" class="absolute inset-0 h-full w-full object-cover grayscale-[35%]" loading="lazy" decoding="async" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
        <div class="absolute bottom-5 left-5 border border-white/15 bg-black/70 px-4 py-3 text-xs text-stone-300 backdrop-blur">
          <span class="mr-2 text-amber-100">●</span> Ciudad Vieja, Montevideo
        </div>
      </div>
    </div>
  </section>

  <section class="-mx-4 bg-stone-100 px-6 py-14 text-stone-950 sm:mx-0 sm:px-10 sm:py-16">
    <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-center">
      <div>
        <div class="text-[10px] font-bold uppercase tracking-[.24em] text-stone-500">Propuesta conceptual · {barber.nombre}</div>
        <h2 class="mt-3 text-4xl font-semibold tracking-[-.045em] sm:text-5xl">{barber.contenido.ctaFinalTitulo}</h2>
        <p class="mt-3 text-sm text-stone-600 sm:text-base">{barber.contenido.ctaFinalBajada}</p>
      </div>
      <a href={ctaPrimary} target={primaryIsExternal ? "_blank" : undefined} rel={primaryIsExternal ? "noopener noreferrer" : undefined} class="inline-flex min-h-14 items-center justify-center bg-stone-950 px-8 text-sm font-bold text-stone-50 transition hover:bg-stone-800">
        {barber.whatsappEsPlaceholder ? "Explorar flujo de reserva" : barber.ctas.principal} <span aria-hidden="true" class="ml-3">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
