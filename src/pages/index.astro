---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/Hero.astro";
import ServiceCard from "@components/ServiceCard.astro";
import barber from "@data/barber.json";
import { buildWhatsAppLink } from "@lib/whatsapp";
const waCourses = buildWhatsAppLink(barber.whatsapp, barber.mensajes.cursos);
const waReference = buildWhatsAppLink(barber.whatsapp, barber.mensajes.referencia);
---
<BaseLayout title={barber.seo.title} description={barber.seo.description}>
  <Hero />
  <section aria-label="Conveniencia" class="border-y border-white/10 bg-[#0b0e0e]"><div class="mx-auto grid max-w-7xl divide-y divide-white/10 px-5 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-8">{[["En el Centro",barber.direccion],["Horarios amplios","Lunes a viernes hasta las 20:00"],["Reserva simple","Elegí la primera hora o tu profesional"]].map(([a,b])=><div class="py-6 sm:px-7"><p class="text-[10px] font-bold uppercase tracking-[.2em] text-cyan-300">{a}</p><p class="mt-2 text-sm text-zinc-300">{b}</p></div>)}</div></section>

  <section id="servicios" class="scroll-mt-24 px-5 py-20 sm:px-8"><div class="mx-auto max-w-6xl"><p class="eyebrow">Servicios actuales</p><div class="mt-3 grid gap-5 lg:grid-cols-2 lg:items-end"><h2 class="section-title">Lo esencial, claro antes de reservar.</h2><p class="max-w-xl text-zinc-400 lg:justify-self-end">Precios y tiempos públicos, en una lectura rápida. Elegí tu servicio y seguí hacia la agenda actual.</p></div><div class="mt-10">{barber.servicios.map(service => <ServiceCard service={service}/>)}</div><p class="mt-5 text-xs text-zinc-500">Disponibilidad y valores finales se confirman en la agenda.</p></div></section>

  <section id="galeria" class="scroll-mt-24 bg-[#0b0e0e] px-5 py-20 sm:px-8"><div class="mx-auto max-w-6xl"><div class="grid gap-8 lg:grid-cols-[.8fr_1.2fr]"><div><p class="eyebrow">Inspiración / trabajos</p><h2 class="section-title mt-3">El resultado entra por los ojos.</h2><p class="mt-5 text-zinc-400">Una estructura editorial lista para reemplazar estas referencias por trabajos autorizados del negocio.</p><a href={barber.instagram} target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex border-b border-cyan-300 pb-1 text-sm font-bold">Ver trabajos publicados en Instagram ↗</a></div><div class="grid grid-cols-2 gap-3"><figure class="relative row-span-2 overflow-hidden"><img src={barber.galeria[0].after} alt="Referencia visual conceptual de un corte" class="h-full min-h-96 w-full object-cover"/><figcaption>Referencia visual de la propuesta</figcaption></figure><figure class="relative overflow-hidden"><img src={barber.galeria[1].after} alt="Referencia visual conceptual de barbería" class="h-48 w-full object-cover"/><figcaption>Referencia visual de la propuesta</figcaption></figure><figure class="relative overflow-hidden"><img src={barber.galeria[2].after} alt="Referencia visual conceptual de un corte" class="h-48 w-full object-cover"/><figcaption>Referencia visual de la propuesta</figcaption></figure></div></div>
    <div class="mt-12 border border-white/10 p-4 sm:p-7"><div class="mb-4 flex items-center justify-between"><h3 class="font-bold">Antes / después</h3><span class="text-[10px] uppercase tracking-wider text-zinc-500">Interacción conceptual</span></div><div class="relative aspect-[16/8] overflow-hidden"><img src={barber.galeria[0].before} alt="Referencia visual antes" class="absolute inset-0 h-full w-full object-cover"/><div id="afterLayer" class="absolute inset-y-0 left-0 w-1/2 overflow-hidden border-r-2 border-cyan-300"><img src={barber.galeria[0].after} alt="Referencia visual después" class="h-full max-w-none object-cover" style="width: calc(100vw - 2.5rem); max-width: 1090px"/></div><input id="compare" aria-label="Comparar antes y después" type="range" min="0" max="100" value="50" class="absolute inset-x-4 bottom-4 accent-cyan-300"/></div></div></div></section>

  <section id="reservar" class="scroll-mt-24 px-5 py-20 sm:px-8"><div class="mx-auto max-w-6xl"><p class="eyebrow">Cómo reservar</p><h2 class="section-title mt-3">Tu agenda, tu forma.</h2><div class="mt-10 grid gap-4 md:grid-cols-2"><a href={barber.agendaAuto} target="_blank" rel="noopener noreferrer" class="group border border-white/15 p-7 transition hover:border-cyan-300"><span class="text-xs text-cyan-300">01</span><h3 class="mt-8 text-2xl font-bold">Primera hora disponible</h3><p class="mt-3 text-sm text-zinc-400">La opción directa para encontrar el próximo turno en la agenda real.</p><span class="mt-8 inline-block font-bold">Abrir agenda ↗</span></a><a href={barber.agendaProfesional} target="_blank" rel="noopener noreferrer" class="group border border-white/15 p-7 transition hover:border-cyan-300"><span class="text-xs text-cyan-300">02</span><h3 class="mt-8 text-2xl font-bold">Elegir profesional</h3><p class="mt-3 text-sm text-zinc-400">Consultá la disponibilidad por profesional dentro de la agenda actual.</p><span class="mt-8 inline-block font-bold">Elegir profesional ↗</span></a></div><div class="mt-4 flex flex-col justify-between gap-4 border border-white/10 bg-white/[.03] p-5 sm:flex-row sm:items-center"><p class="text-sm text-zinc-400">¿Querés enviar una referencia o hacer una consulta antes?</p><a href={waReference} target="_blank" rel="noopener noreferrer" class="font-bold text-cyan-300">Enviar por WhatsApp ↗</a></div></div></section>

  <section class="bg-cyan-300 px-5 py-20 text-black sm:px-8"><div class="mx-auto max-w-6xl"><p class="text-xs font-black uppercase tracking-[.2em]">De una búsqueda a un turno</p><h2 class="mt-4 max-w-3xl text-4xl font-black tracking-[-.04em] sm:text-6xl">Una capa que ordena el interés y lo lleva a la acción.</h2><div class="mt-12 grid gap-px bg-black/20 md:grid-cols-3">{[["01","Te encuentran","En Google, Instagram o una búsqueda local."],["02","Entienden","Servicios, precios, trabajos y ubicación, sin fricción."],["03","Avanzan","Llegan a la agenda o a la consulta correcta."]].map(([n,t,d])=><div class="bg-cyan-300 py-6 md:px-6"><span class="text-xs">{n}</span><h3 class="mt-5 text-xl font-black">{t}</h3><p class="mt-2 text-sm">{d}</p></div>)}</div></div></section>

  <section class="px-5 py-20 sm:px-8"><div class="mx-auto max-w-6xl"><div class="rounded-[2rem] border border-cyan-300/25 bg-cyan-300/[.04] p-7 sm:p-12"><p class="eyebrow">Propuesta · próxima etapa</p><h2 class="section-title mt-3">Módulos propuestos para una próxima etapa.</h2><div class="mt-10 grid gap-8 md:grid-cols-3">{[["QR / reseñas","Facilitar el acceso a opiniones públicas después de la visita."],["Recordatorio de retoque","Proponer un contacto oportuno, sujeto a implementación y consentimiento."],["Métricas de clics","Conocer clics hacia agenda, WhatsApp e Instagram."]].map(([t,d])=><div><span class="block h-px w-8 bg-cyan-300"></span><h3 class="mt-5 text-lg font-bold">{t}</h3><p class="mt-2 text-sm leading-relaxed text-zinc-400">{d}</p><small class="mt-4 block text-[10px] uppercase text-zinc-600">Demo conceptual · no activo</small></div>)}</div></div></div></section>

  <section class="bg-[#0b0e0e] px-5 py-20 sm:px-8"><div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-2 lg:items-center"><div><p class="eyebrow">Academia</p><h2 class="section-title mt-3">Cursos de barbería.</h2><p class="mt-5 max-w-lg text-zinc-400">Techno Barber también comunica cursos. Consultá directamente para conocer la información disponible, sin fechas ni cupos inventados.</p><a href={waCourses} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex bg-white px-6 py-4 font-extrabold text-black">Consultar cursos por WhatsApp ↗</a></div><div class="border-l border-cyan-300 px-6 py-12"><p class="text-2xl font-bold leading-snug">Técnica, práctica y cultura de barbería en un canal de consulta directo.</p><p class="mt-4 text-xs uppercase tracking-wider text-zinc-500">Información confirmada por WhatsApp</p></div></div></section>

  <section id="ubicacion" class="scroll-mt-24 px-5 py-20 sm:px-8"><div class="mx-auto grid max-w-6xl gap-8 lg:grid-cols-[.9fr_1.1fr]"><div><p class="eyebrow">Ubicación y reputación</p><h2 class="section-title mt-3">En el Centro, fácil de ubicar.</h2><p class="mt-6 text-xl font-bold">{barber.direccion}</p><p class="mt-1 text-zinc-500">{barber.barrio}, {barber.ciudad}</p><div class="mt-7">{barber.horarios.map(h=><div class="flex justify-between border-b border-white/10 py-3 text-sm"><span class="text-zinc-400">{h.dias}</span><strong>{h.horas}</strong></div>)}</div><div class="mt-7 flex flex-wrap gap-4 text-sm font-bold"><a href={barber.maps} target="_blank" rel="noopener noreferrer" class="text-cyan-300">Google Maps ↗</a><a href={barber.waze} target="_blank" rel="noopener noreferrer">Waze ↗</a><a href={barber.opiniones} target="_blank" rel="noopener noreferrer">Ver opiniones públicas ↗</a></div></div><figure class="relative min-h-96 overflow-hidden"><img src={barber.media.location} alt="Referencia visual conceptual de ubicación urbana" class="absolute inset-0 h-full w-full object-cover grayscale"/><figcaption>Referencia visual de la propuesta · La dirección indicada es real</figcaption></figure></div></section>

  <section class="bg-white px-5 py-16 text-black sm:px-8"><div class="mx-auto flex max-w-6xl flex-col justify-between gap-8 lg:flex-row lg:items-center"><div><p class="text-xs font-black uppercase tracking-[.2em]">La agenda actual, mejor acompañada</p><h2 class="mt-3 text-4xl font-black tracking-[-.04em] sm:text-5xl">Encontrá tu próximo turno.</h2></div><a href={barber.agendaAuto} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-14 items-center justify-center bg-black px-8 font-extrabold text-white">Ver turnos disponibles ↗</a></div></section>
  <script is:inline>document.getElementById('compare')?.addEventListener('input',e=>{document.getElementById('afterLayer').style.width=e.target.value+'%'})</script>
</BaseLayout>
