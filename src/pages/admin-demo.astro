---
import BaseLayout from '@layouts/BaseLayout.astro'; import barber from '@data/barber.json';
---
<BaseLayout title="Panel demostrativo — Techno Barber" description="Panel local demostrativo de contenido.">
<section class="mx-auto max-w-7xl px-5 py-14"><div class="flex flex-col justify-between gap-5 border-b border-white/10 pb-8 sm:flex-row sm:items-end"><div><p class="eyebrow">Demo de autonomía</p><h1 class="mt-3 max-w-4xl text-3xl font-black sm:text-5xl">Editá contenido y mirá el resultado antes de avanzar.</h1><p class="mt-4 text-sm font-bold text-cyan-300">Cambios guardados solo en este navegador.</p></div><button id="reset" class="border border-white/20 px-5 py-3 text-sm font-bold">Restaurar demo</button></div>
<ol class="mt-8 grid gap-px bg-white/10 sm:grid-cols-3" aria-label="Flujo de edición"><li class="bg-cyan-300 p-4 font-black text-black">01 · Editar</li><li class="bg-[#111414] p-4 font-bold">02 · Vista previa</li><li class="bg-[#111414] p-4 text-zinc-400">03 · Publicar al conectar panel real</li></ol>
<form id="editor" class="mt-10 grid gap-8 xl:grid-cols-[.9fr_1.1fr]">
<div class="space-y-7"><fieldset class="border border-white/10 p-5"><legend class="px-2 font-bold">Hero</legend><label class="block text-sm text-zinc-400">Título<input id="hero-title" value={barber.hero.titulo} class="mt-2 w-full border border-white/15 bg-black p-3 text-white"/></label><label class="mt-4 block text-sm text-zinc-400">Subtítulo<textarea id="hero-subtitle" class="mt-2 min-h-24 w-full border border-white/15 bg-black p-3 text-white">{barber.hero.subtitulo}</textarea></label></fieldset>
<fieldset class="border border-white/10 p-5"><div class="flex items-center justify-between"><legend class="px-2 font-bold">Servicios</legend><button id="add-service" type="button" class="text-sm font-bold text-cyan-300">+ Agregar</button></div><div id="service-editor" class="mt-4 space-y-4"></div></fieldset>
<fieldset class="border border-white/10 p-5"><legend class="px-2 font-bold">Galería local</legend><label class="block cursor-pointer border border-dashed border-white/20 p-7 text-center text-sm text-zinc-400">Cargar varias imágenes para previsualización<input id="image-input" type="file" accept="image/*" multiple class="sr-only"/></label><p class="mt-3 text-xs text-zinc-600">Los archivos quedan en este navegador y no se suben al sitio.</p><div id="image-editor" class="mt-4 grid grid-cols-2 gap-3"></div></fieldset>
<button class="w-full bg-cyan-300 px-6 py-4 font-black text-black">Guardar en este navegador</button><p id="status" role="status" class="text-sm text-zinc-400"></p></div>
<div class="xl:sticky xl:top-24 xl:self-start"><p class="mb-3 text-xs font-black uppercase tracking-[.18em] text-cyan-300">Vista previa completa</p><div id="site-preview" class="overflow-hidden border border-white/15 bg-[#070909]"><div class="bg-gradient-to-br from-zinc-800 to-black p-7 sm:p-10"><span class="text-[10px] font-black uppercase tracking-widest text-cyan-300">Centro · Montevideo</span><h2 id="preview-title" class="mt-4 text-4xl font-black leading-none"></h2><p id="preview-subtitle" class="mt-4 max-w-lg text-sm text-zinc-300"></p><span class="mt-6 inline-block bg-cyan-300 px-4 py-3 text-xs font-black text-black">Ver turnos disponibles ↗</span></div><div class="p-6"><p class="text-[10px] font-black uppercase tracking-widest text-cyan-300">Servicios</p><div id="service-preview" class="mt-4"></div></div><div class="border-t border-white/10 p-6"><p class="text-[10px] font-black uppercase tracking-widest text-cyan-300">Galería</p><div id="gallery-preview" class="mt-4 grid grid-cols-3 gap-2"></div><p id="gallery-empty" class="mt-3 text-sm text-zinc-500">Cargá imágenes para ver el mosaico.</p></div></div><aside class="mt-5 border border-cyan-300/20 bg-cyan-300/5 p-5"><h2 class="font-bold">Alcance de la versión contratada</h2><p class="mt-2 text-sm leading-relaxed text-zinc-400">La versión contratada puede conectarse a un CMS con usuarios, almacenamiento y publicación segura.</p><p class="mt-3 text-xs text-zinc-600">Esta demo no tiene backend, usuarios ni flujo de publicación; guardar acá no modifica la web pública.</p></aside></div>
</form></section>
<script is:inline define:vars={{ initialServices: barber.servicios }}>
const key='techno-barber-admin-demo-v2';
const defaults={heroTitle:document.querySelector('#hero-title').value,heroSubtitle:document.querySelector('#hero-subtitle').value,services:initialServices.map(({nombre,precio,duracion,descripcion,destacado})=>({nombre,precio,duracion,descripcion,destacado})),images:[]};
let state;try{state={...defaults,...JSON.parse(localStorage.getItem(key)||'{}')}}catch{state=structuredClone(defaults)}
const $=selector=>document.querySelector(selector);const escape=value=>String(value).replace(/[&<>'"]/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
$('#hero-title').value=state.heroTitle;$('#hero-subtitle').value=state.heroSubtitle;
function renderEditor(){
 $('#service-editor').innerHTML=state.services.map((service,index)=>`<article class="service-row border border-white/10 p-4" data-index="${index}"><div class="grid gap-3 sm:grid-cols-2"><label class="text-xs text-zinc-500">Nombre<input data-field="nombre" value="${escape(service.nombre)}" class="mt-1 w-full bg-black p-3 text-white"></label><label class="text-xs text-zinc-500">Precio<input data-field="precio" value="${Number(service.precio)||0}" type="number" min="0" class="mt-1 w-full bg-black p-3 text-white"></label><label class="text-xs text-zinc-500">Duración<input data-field="duracion" value="${Number(service.duracion)||0}" type="number" min="0" class="mt-1 w-full bg-black p-3 text-white"></label><label class="flex items-center gap-2 pt-5 text-sm"><input data-field="destacado" type="checkbox" ${service.destacado?'checked':''}> Destacar en home</label><label class="text-xs text-zinc-500 sm:col-span-2">Descripción<textarea data-field="descripcion" class="mt-1 w-full bg-black p-3 text-white">${escape(service.descripcion)}</textarea></label></div><button type="button" data-remove-service="${index}" class="mt-3 text-xs font-bold text-red-300">Eliminar servicio</button></article>`).join('');
}
function syncFromEditor(){document.querySelectorAll('.service-row').forEach(row=>{const service=state.services[Number(row.dataset.index)];row.querySelectorAll('[data-field]').forEach(input=>{const field=input.dataset.field;service[field]=input.type==='checkbox'?input.checked:input.type==='number'?Number(input.value):input.value})})}
function renderPreview(){state.heroTitle=$('#hero-title').value;state.heroSubtitle=$('#hero-subtitle').value;$('#preview-title').textContent=state.heroTitle;$('#preview-subtitle').textContent=state.heroSubtitle;$('#service-preview').innerHTML=state.services.map(s=>`<div class="flex justify-between gap-3 border-t border-white/10 py-3"><div><strong>${escape(s.nombre)}</strong>${s.destacado?'<span class="ml-2 text-[8px] uppercase text-cyan-300">Home</span>':''}<p class="text-xs text-zinc-500">${escape(s.descripcion)}</p></div><span class="shrink-0 text-sm font-bold">$ ${Number(s.precio)||0}</span></div>`).join('')||'<p class="text-sm text-zinc-500">Sin servicios en la vista previa.</p>';$('#gallery-preview').innerHTML=state.images.map((src,index)=>`<div class="relative"><img src="${src}" alt="Vista previa local ${index+1}" class="aspect-square w-full object-cover"><button type="button" data-remove-image="${index}" aria-label="Eliminar imagen ${index+1}" class="absolute right-1 top-1 grid h-7 w-7 place-items-center bg-black/80 text-xs">×</button></div>`).join('');$('#gallery-empty').classList.toggle('hidden',state.images.length>0)}
renderEditor();renderPreview();
$('#editor').addEventListener('input',event=>{if(event.target.closest('.service-row'))syncFromEditor();renderPreview()});
$('#service-editor').addEventListener('click',event=>{const button=event.target.closest('[data-remove-service]');if(!button)return;syncFromEditor();state.services.splice(Number(button.dataset.removeService),1);renderEditor();renderPreview()});
$('#add-service').addEventListener('click',()=>{syncFromEditor();state.services.push({nombre:'Nuevo servicio',precio:0,duracion:30,descripcion:'Descripción editable.',destacado:false});renderEditor();renderPreview()});
$('#image-input').addEventListener('change',async event=>{const files=[...event.target.files];for(const file of files){const src=await new Promise(resolve=>{const reader=new FileReader();reader.onload=()=>resolve(reader.result);reader.readAsDataURL(file)});state.images.push(src)}renderPreview();event.target.value=''});
$('#gallery-preview').addEventListener('click',event=>{const button=event.target.closest('[data-remove-image]');if(!button)return;state.images.splice(Number(button.dataset.removeImage),1);renderPreview()});
$('#editor').addEventListener('submit',event=>{event.preventDefault();syncFromEditor();state.heroTitle=$('#hero-title').value;state.heroSubtitle=$('#hero-subtitle').value;try{localStorage.setItem(key,JSON.stringify(state));$('#status').textContent='Cambios guardados localmente. La web pública no fue modificada.'}catch{$('#status').textContent='No se pudo guardar: las imágenes superan el espacio disponible en este navegador.'}});
$('#reset').addEventListener('click',()=>{localStorage.removeItem(key);location.reload()});
</script>
</BaseLayout>
