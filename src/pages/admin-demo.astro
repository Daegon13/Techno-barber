---
import BaseLayout from '@layouts/BaseLayout.astro'; import barber from '@data/barber.json';
---
<BaseLayout title="Panel demostrativo — Techno Barber" description="Panel local demostrativo de contenido.">
<section class="mx-auto max-w-6xl px-5 py-14"><div class="flex flex-col justify-between gap-4 border-b border-white/10 pb-8 sm:flex-row sm:items-end"><div><p class="eyebrow">Solo demostración</p><h1 class="mt-3 text-3xl font-black sm:text-5xl">Panel demostrativo de gestión de contenido</h1><p class="mt-4 text-sm text-zinc-400">Los cambios se guardan solo en este navegador para la demostración.</p></div><button id="reset" class="border border-white/20 px-5 py-3 text-sm font-bold">Restaurar demo</button></div>
<form id="editor" class="mt-10 grid gap-8 lg:grid-cols-[1fr_.9fr]">
<div class="space-y-8"><fieldset class="border border-white/10 p-5"><legend class="px-2 font-bold">Hero</legend><label class="block text-sm text-zinc-400">Título<input name="heroTitle" value={barber.hero.titulo} class="mt-2 w-full border border-white/15 bg-black p-3 text-white"/></label><label class="mt-4 block text-sm text-zinc-400">Subtítulo<textarea name="heroSubtitle" class="mt-2 min-h-24 w-full border border-white/15 bg-black p-3 text-white">{barber.hero.subtitulo}</textarea></label></fieldset>
<fieldset class="border border-white/10 p-5"><legend class="px-2 font-bold">Servicios</legend><div id="services" class="space-y-5">{barber.servicios.map((s,i)=><div class="grid gap-3 border-b border-white/10 pb-5 sm:grid-cols-2"><input aria-label="Nombre" name={`service-${i}-name`} value={s.nombre} class="bg-black p-3"/><input aria-label="Precio" name={`service-${i}-price`} value={s.precio} type="number" class="bg-black p-3"/><input aria-label="Duración" name={`service-${i}-duration`} value={s.duracion} type="number" class="bg-black p-3"/><label class="flex items-center gap-2 text-sm"><input name={`service-${i}-featured`} type="checkbox" checked={s.destacado}/> Destacado</label><textarea aria-label="Descripción" name={`service-${i}-description`} class="bg-black p-3 sm:col-span-2">{s.descripcion}</textarea></div>)}</div></fieldset></div>
<div><fieldset class="border border-white/10 p-5"><legend class="px-2 font-bold">Galería local</legend><label class="block cursor-pointer border border-dashed border-white/20 p-7 text-center text-sm text-zinc-400">Cargar imagen para previsualización<input id="imageInput" type="file" accept="image/*" class="sr-only"/></label><div id="imagePreview" class="mt-4"></div><button id="removeImage" type="button" class="mt-3 hidden text-sm text-cyan-300">Eliminar imagen</button></fieldset><aside class="mt-6 border border-cyan-300/20 bg-cyan-300/5 p-5"><h2 class="font-bold">Vista previa local</h2><p id="previewTitle" class="mt-4 text-3xl font-black">{barber.hero.titulo}</p><p id="previewSubtitle" class="mt-2 text-sm text-zinc-400">{barber.hero.subtitulo}</p><p class="mt-6 text-xs text-zinc-500">Para publicar este contenido habría que conectar un panel real, almacenamiento y un flujo de publicación. Nada de eso está activo en esta demo.</p></aside><button class="mt-5 w-full bg-cyan-300 px-6 py-4 font-black text-black">Guardar en este navegador</button><p id="status" role="status" class="mt-3 text-sm text-zinc-400"></p></div>
</form></section>
<script is:inline define:vars={{ defaults: JSON.stringify(barber) }}>
const key='techno-barber-admin-demo'; const form=document.querySelector('#editor'); const title=form.elements.heroTitle; const subtitle=form.elements.heroSubtitle; const status=document.querySelector('#status');
const update=()=>{document.querySelector('#previewTitle').textContent=title.value;document.querySelector('#previewSubtitle').textContent=subtitle.value};
const saved=localStorage.getItem(key); if(saved){const data=JSON.parse(saved); title.value=data.heroTitle||title.value;subtitle.value=data.heroSubtitle||subtitle.value;update()}
title.addEventListener('input',update);subtitle.addEventListener('input',update);form.addEventListener('submit',e=>{e.preventDefault();localStorage.setItem(key,JSON.stringify(Object.fromEntries(new FormData(form))));status.textContent='Cambios guardados localmente.'});
document.querySelector('#reset').addEventListener('click',()=>{localStorage.removeItem(key);location.reload()}); const input=document.querySelector('#imageInput'), preview=document.querySelector('#imagePreview'), remove=document.querySelector('#removeImage');input.addEventListener('change',()=>{const file=input.files[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{preview.innerHTML=`<img src="${reader.result}" alt="Vista previa local" class="w-full max-h-80 object-cover">`;remove.classList.remove('hidden');localStorage.setItem(key+'-image',reader.result)};reader.readAsDataURL(file)});remove.addEventListener('click',()=>{preview.innerHTML='';input.value='';remove.classList.add('hidden');localStorage.removeItem(key+'-image')});const image=localStorage.getItem(key+'-image');if(image){preview.innerHTML=`<img src="${image}" alt="Vista previa local" class="w-full max-h-80 object-cover">`;remove.classList.remove('hidden')}
</script>
</BaseLayout>
