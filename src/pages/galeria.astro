---
import BaseLayout from '@layouts/BaseLayout.astro'; import barber from '@data/barber.json';
---
<BaseLayout title={`Galería conceptual — ${barber.nombre}`} description="Estructura visual conceptual preparada para trabajos autorizados."><section class="mx-auto max-w-6xl px-5 py-20"><p class="eyebrow">Galería conceptual</p><h1 class="section-title mt-3">Una vidriera para el trabajo real.</h1><p class="mt-5 max-w-xl text-zinc-400">Estas imágenes son referencias visuales de la propuesta, no trabajos de Techno Barber.</p><div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">{barber.galeria.map(item=><figure class="relative overflow-hidden"><img src={item.after} alt="Referencia visual conceptual" class="aspect-[4/5] w-full object-cover"/><figcaption>Referencia visual de la propuesta</figcaption></figure>)}</div><a href={barber.instagram} target="_blank" rel="noopener noreferrer" class="mt-8 inline-flex bg-cyan-300 px-6 py-4 font-bold text-black">Ver trabajos publicados ↗</a></section></BaseLayout>
