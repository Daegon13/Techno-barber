---
import BaseLayout from '@layouts/BaseLayout.astro'; import ServiceCard from '@components/ServiceCard.astro'; import barber from '@data/barber.json'; import { buildWhatsAppLink } from '@lib/whatsapp';
---
<BaseLayout title={`Servicios — ${barber.nombre}`} description="Servicios, precios y duración publicados por Techno Barber."><section class="border-b border-white/10 px-5 py-16 sm:px-8"><div class="mx-auto flex max-w-5xl flex-col justify-between gap-8 md:flex-row md:items-end"><div><p class="eyebrow">Techno Barber</p><h1 class="section-title mt-3">Servicios.</h1><p class="mt-5 max-w-xl text-zinc-400">Revisá opciones y seguí a la agenda oficial para confirmar disponibilidad y valor final.</p></div><div class="flex flex-col gap-2 sm:flex-row md:sticky md:top-24"><a href={barber.agendaAuto} target="_blank" rel="noopener noreferrer" class="bg-cyan-300 px-5 py-4 text-center font-black text-black">Ver agenda ↗</a><a href={buildWhatsAppLink(barber.whatsapp,barber.mensajes.consulta)} target="_blank" rel="noopener noreferrer" class="border border-white/20 px-5 py-4 text-center font-bold">WhatsApp ↗</a></div></div></section><section class="mx-auto max-w-5xl px-5 py-14"><div>{barber.servicios.map(service=><ServiceCard service={service}/>)}</div><p class="mt-6 text-xs text-zinc-500">Disponibilidad y valores finales se confirman en la agenda.</p></section></BaseLayout>
