---
import BaseLayout from '@layouts/BaseLayout.astro'; import ServiceCard from '@components/ServiceCard.astro'; import barber from '@data/barber.json';
---
<BaseLayout title={`Servicios — ${barber.nombre}`} description="Servicios, precios y duración publicados por Techno Barber."><section class="mx-auto max-w-5xl px-5 py-20"><p class="eyebrow">Techno Barber</p><h1 class="section-title mt-3">Servicios.</h1><div class="mt-12">{barber.servicios.map(service=><ServiceCard service={service}/>)}</div><p class="mt-6 text-xs text-zinc-500">Disponibilidad y valores finales se confirman en la agenda.</p></section></BaseLayout>
