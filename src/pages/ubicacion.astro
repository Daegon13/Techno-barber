---
import BaseLayout from "@layouts/BaseLayout.astro";
import barber from "@data/barber.json";

const title = `Ubicación y horarios — ${barber.nombre}`;
const description = `${barber.nombre} en ${barber.direccion}, ${barber.ciudad}. Atención privada con agenda previa.`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${barber.direccion}, ${barber.barrio}, ${barber.ciudad}`)}`;
---

<BaseLayout title={title} description={description}>
  <section class="py-10">
    <h1 class="text-2xl font-semibold text-zinc-50">Ubicación y horarios</h1>
    <p class="mt-2 text-sm text-zinc-400">{barber.direccion} · {barber.barrio}, {barber.ciudad}</p>
    <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex min-h-12 items-center justify-center border border-white/15 px-5 text-sm font-semibold text-zinc-100 transition hover:bg-white/10">
      Cómo llegar con Google Maps <span aria-hidden="true" class="ml-2">↗</span>
    </a>

    <div class="mt-6 overflow-hidden rounded-2xl border border-white/10 bg-white/5 shadow-soft">
      <img src={barber.media.location} alt="Imagen conceptual de la ubicación del estudio" class="h-[260px] w-full object-cover md:h-[360px]" loading="lazy" decoding="async" />
    </div>

    <div class="mt-6 rounded-2xl border border-white/10 bg-white/5 p-5">
      {barber.horarios.map((horario) => (
        <div class="flex justify-between gap-4 border-b border-white/10 py-3 last:border-0">
          <span class="text-sm text-zinc-300">{horario.dias}</span>
          <span class="text-sm font-semibold text-zinc-100">{horario.horas}</span>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
