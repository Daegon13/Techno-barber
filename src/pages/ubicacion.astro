---
import BaseLayout from '@layouts/BaseLayout.astro'; import barber from '@data/barber.json';
---
<BaseLayout title={`Ubicación — ${barber.nombre}`} description={`${barber.direccion}, Centro, Montevideo.`}><section class="mx-auto max-w-5xl px-5 py-20"><p class="eyebrow">Centro · Montevideo</p><h1 class="section-title mt-3">{barber.direccion}</h1><div class="mt-8 flex gap-5"><a href={barber.maps} target="_blank" rel="noopener noreferrer" class="text-cyan-300">Google Maps ↗</a><a href={barber.waze} target="_blank" rel="noopener noreferrer">Waze ↗</a></div><div class="mt-10 max-w-xl">{barber.horarios.map(h=><div class="flex justify-between border-b border-white/10 py-4"><span>{h.dias}</span><strong>{h.horas}</strong></div>)}</div></section></BaseLayout>
