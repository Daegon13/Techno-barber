---
import BaseLayout from '@layouts/BaseLayout.astro'; import barber from '@data/barber.json';
---
<BaseLayout title={`Ubicación — ${barber.nombre}`} description={`${barber.direccion}, Centro, Montevideo.`}><section class="mx-auto grid max-w-6xl gap-10 px-5 py-20 lg:grid-cols-[1fr_.8fr]"><div><p class="eyebrow">Centro · Montevideo</p><h1 class="section-title mt-3">Cómo llegar.</h1><p class="mt-6 text-2xl font-black">{barber.direccion}</p><p class="mt-2 text-zinc-500">{barber.barrio}, {barber.ciudad}</p><div class="mt-8 flex flex-wrap gap-3"><a href={barber.maps} target="_blank" rel="noopener noreferrer" class="bg-cyan-300 px-6 py-4 font-black text-black">Cómo llegar con Google Maps ↗</a><a href={barber.waze} target="_blank" rel="noopener noreferrer" class="border border-white/20 px-6 py-4 font-bold">Abrir Waze ↗</a></div></div><aside class="border border-white/10 bg-white/[.025] p-6"><h2 class="text-xl font-black">Horarios</h2><div class="mt-5">{barber.horarios.map(h=><div class="flex justify-between gap-4 border-b border-white/10 py-4 text-sm"><span class="text-zinc-400">{h.dias}</span><strong>{h.horas}</strong></div>)}</div><a href={barber.opiniones} target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex text-sm font-bold text-cyan-300">Ver reseñas públicas en Google ↗</a></aside></section></BaseLayout>
