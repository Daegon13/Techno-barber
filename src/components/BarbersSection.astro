---
type Barbero = {
  nombre: string;
  especialidad: string;
  foto?: string;
  alt?: string;
};

type Props = {
  barberos: Barbero[];
};

const { barberos } = Astro.props as Props;
---

<section class="py-14 sm:py-20">
  <div class="flex items-end justify-between gap-6">
    <div>
      <span class="block h-px w-10 bg-amber-200/60"></span>
      <h2 class="mt-3 text-3xl font-semibold tracking-[-.035em] text-stone-50 sm:text-4xl">El equipo detrás del detalle.</h2>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-stone-400 sm:text-base">Profesionales enfocados en técnica, criterio y terminaciones precisas.</p>
    </div>
  </div>

  <div class="mt-8 grid grid-cols-2 gap-3 sm:mt-10 sm:gap-4 lg:grid-cols-4">
    {barberos.map((b) => (
      <article class="group overflow-hidden border border-white/10 bg-[#10100f]">
        {b.foto ? (
          <img
            src={b.foto}
            alt={b.alt ?? b.nombre}
            class="aspect-[3/4] w-full object-cover grayscale-[30%] transition duration-700 group-hover:scale-[1.03] group-hover:grayscale-0"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="h-56 w-full bg-gradient-to-b from-white/5 to-black/20"></div>
        )}

        <div class="p-4 sm:p-5">
          <div class="text-base font-semibold text-stone-50">{b.nombre}</div>
          <div class="mt-1 text-xs uppercase tracking-[.1em] text-stone-500">{b.especialidad}</div>
        </div>
      </article>
    ))}
  </div>
</section>
