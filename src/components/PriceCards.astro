---
import { formatUYU } from "@lib/whatsapp";
import type { Servicio } from "@lib/types";

type Props = { services: Servicio[] };
const { services } = Astro.props as Props;
---

<div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
  {services.map((service) => (
    <article class="rounded-2xl border border-white/10 bg-white/5 p-5">
      <div class="flex items-start justify-between gap-3">
        <div class="font-semibold text-zinc-50">{service.nombre}</div>
        <div class="text-right font-semibold text-zinc-50">
          {service.precio !== null ? formatUYU(service.precio) : (service.detallePrecio ?? "Consultar")}
        </div>
      </div>
      <div class="mt-1 text-sm text-zinc-400">
        {service.duracion ? `${service.duracion} min` : "Duración a coordinar"}
      </div>
    </article>
  ))}
</div>
