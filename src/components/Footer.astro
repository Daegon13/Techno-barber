---
import barber from "@data/barber.json";
---

<footer class="border-t border-white/10 bg-[#070706]">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-6">
      <div>
        <div class="text-sm font-bold uppercase tracking-[.18em] text-stone-50">{barber.nombre}</div>
        <div class="mt-2 text-xs text-stone-400">{barber.concepto}</div>
        <div class="mt-1 text-xs text-stone-500">{barber.direccion} · {barber.ciudad}</div>
      </div>

      <div class="text-xs leading-relaxed text-stone-400 sm:text-right">
        {barber.horarios.map((horario) => (
          <div>{horario.dias}: {horario.horas}</div>
        ))}
      </div>
    </div>

    <p class="mt-8 max-w-3xl border-t border-white/[.07] pt-6 text-[11px] leading-relaxed text-stone-600">{barber.avisoDemo}</p>
  </div>
</footer>
