---
import barber from "@data/barber.json";

const { conversion, reputacion, retencion } = barber.capaComercial;
---

<section aria-labelledby="conversion-title" class="border-y border-white/10 bg-[#0a0a09] py-14 sm:py-20">
  <div class="grid gap-10 lg:grid-cols-[.85fr_1.15fr] lg:gap-16">
    <div>
      <div class="text-[10px] font-bold uppercase tracking-[.24em] text-amber-100/70">{conversion.eyebrow}</div>
      <h2 id="conversion-title" class="mt-4 max-w-xl text-3xl font-semibold tracking-[-.04em] text-stone-50 sm:text-4xl">{conversion.titulo}</h2>
      <p class="mt-4 max-w-xl text-sm leading-relaxed text-stone-400 sm:text-base">{conversion.bajada}</p>
      <div class="mt-6 inline-flex items-center gap-3 border border-amber-200/20 bg-amber-100/[.04] px-4 py-3 text-xs font-semibold text-amber-50">
        <span class="h-1.5 w-1.5 rounded-full bg-amber-200"></span>
        {conversion.nota}
      </div>
    </div>

    <div class="grid gap-px overflow-hidden border border-white/10 bg-white/10 sm:grid-cols-3">
      {conversion.beneficios.map((beneficio, index) => (
        <article class="bg-[#10100f] p-6 sm:min-h-56">
          <span class="text-[10px] font-bold tracking-[.2em] text-stone-600">0{index + 1}</span>
          <h3 class="mt-8 text-lg font-semibold text-stone-100">{beneficio.titulo}</h3>
          <p class="mt-3 text-sm leading-relaxed text-stone-500">{beneficio.texto}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section aria-labelledby="reputacion-title" class="py-14 sm:py-20">
  <div class="mb-9 max-w-2xl">
    <span class="block h-px w-10 bg-amber-200/60"></span>
    <div class="mt-4 text-[10px] font-bold uppercase tracking-[.24em] text-amber-100/70">{reputacion.eyebrow}</div>
    <h2 id="reputacion-title" class="mt-3 text-3xl font-semibold tracking-[-.04em] text-stone-50 sm:text-4xl">{reputacion.titulo}</h2>
    <p class="mt-4 text-sm leading-relaxed text-stone-400 sm:text-base">{reputacion.bajada}</p>
  </div>

  <div class="grid gap-3 md:grid-cols-3">
    {reputacion.pasos.map((paso) => (
      <article class="relative border border-white/10 bg-white/[.025] p-6">
        <div class="text-3xl font-semibold tracking-[-.05em] text-amber-100/25">{paso.numero}</div>
        <h3 class="mt-6 text-lg font-semibold text-stone-100">{paso.titulo}</h3>
        <p class="mt-2 text-sm leading-relaxed text-stone-500">{paso.texto}</p>
      </article>
    ))}
  </div>
  <p class="mt-4 text-xs leading-relaxed text-stone-600">{reputacion.nota}</p>
</section>

<section aria-labelledby="retencion-title" class="overflow-hidden border border-white/10 bg-[#11110f]">
  <div class="grid lg:grid-cols-[1fr_1fr]">
    <div class="border-b border-white/10 p-6 sm:p-10 lg:border-b-0 lg:border-r">
      <div class="text-[10px] font-bold uppercase tracking-[.24em] text-amber-100/70">{retencion.eyebrow}</div>
      <h2 id="retencion-title" class="mt-4 max-w-lg text-3xl font-semibold tracking-[-.04em] text-stone-50 sm:text-4xl">{retencion.titulo}</h2>
      <p class="mt-4 max-w-lg text-sm leading-relaxed text-stone-400 sm:text-base">{retencion.bajada}</p>
      <div class="mt-8 flex flex-wrap gap-2" aria-label="Frecuencias conceptuales de recordatorio">
        {retencion.frecuencias.map((frecuencia) => (
          <span class="border border-white/10 bg-black/20 px-4 py-2 text-xs font-semibold text-stone-300">{frecuencia}</span>
        ))}
      </div>
    </div>
    <div class="flex flex-col justify-center p-6 sm:p-10">
      <ul class="grid gap-4">
        {retencion.beneficios.map((beneficio) => (
          <li class="flex gap-4 text-sm leading-relaxed text-stone-300">
            <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-200"></span>
            {beneficio}
          </li>
        ))}
      </ul>
      <p class="mt-8 border-t border-white/10 pt-5 text-xs leading-relaxed text-stone-600">{retencion.nota}</p>
    </div>
  </div>
</section>
