---
import barber from "@data/barber.json";
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-[#070909]/90 backdrop-blur-xl">
  <div class="mx-auto flex h-[72px] max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-3 rounded-sm" aria-label="Techno Barber, inicio">
      <span class="grid h-9 w-9 place-items-center border border-cyan-300/50 text-xs font-black text-cyan-300">TB</span>
      <span><strong class="block text-sm uppercase tracking-[.16em]">Techno Barber</strong><small class="hidden text-[9px] uppercase tracking-[.22em] text-zinc-500 sm:block">Centro · Montevideo</small></span>
    </a>
    <nav aria-label="Navegación principal" class="hidden gap-7 text-xs font-semibold text-zinc-400 md:flex">
      <a href="/#servicios" class="hover:text-white">Servicios</a><a href="/#galeria" class="hover:text-white">Trabajos</a><a href="/#reservar" class="hover:text-white">Reservar</a><a href="/#ubicacion" class="hover:text-white">Ubicación</a>
    </nav>
    <a href={barber.agendaAuto} target="_blank" rel="noopener noreferrer" class="bg-cyan-300 px-4 py-3 text-xs font-extrabold text-black transition hover:bg-white">Ver turnos</a>
  </div>
</header>
