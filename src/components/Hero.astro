---
import barber from "@data/barber.json";
import { buildWhatsAppLink } from "@lib/whatsapp";
---
<section class="relative min-h-[calc(100svh-72px)] overflow-hidden bg-black">
  <picture class="absolute inset-0"><source media="(max-width: 700px)" srcset={barber.media.heroMobile}/><img src={barber.media.heroDesktop} alt="Referencia visual conceptual de barbería contemporánea" class="h-full w-full object-cover opacity-65" fetchpriority="high" /></picture>
  <div class="absolute inset-0 bg-gradient-to-r from-black via-black/70 to-transparent"></div><div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/40"></div>
  <div class="relative mx-auto flex min-h-[calc(100svh-72px)] max-w-7xl items-end px-5 py-12 sm:items-center sm:px-8 lg:px-12">
    <div class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[.28em] text-cyan-300">{barber.hero.eyebrow}</p>
      <h1 class="mt-5 text-5xl font-black leading-[.9] tracking-[-.055em] text-white sm:text-7xl lg:text-8xl">{barber.hero.titulo}</h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-zinc-200 sm:text-xl">{barber.hero.subtitulo}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row"><a href={barber.agendaAuto} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-14 items-center justify-center bg-cyan-300 px-7 font-extrabold text-black hover:bg-white">Ver turnos disponibles ↗</a><a href="#servicios" class="inline-flex min-h-14 items-center justify-center border border-white/30 bg-black/30 px-7 font-bold backdrop-blur">Ver servicios ↓</a><a href={buildWhatsAppLink(barber.whatsapp, barber.mensajes.consulta)} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-14 items-center justify-center px-4 text-sm font-semibold text-zinc-200 underline decoration-zinc-600 underline-offset-4">Consultar por WhatsApp</a></div>
      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-xs text-zinc-300"><span>● {barber.direccion}</span><span class="text-cyan-300">Agenda online disponible</span></div>
      <p class="absolute bottom-3 right-4 text-[9px] uppercase tracking-wider text-white/45">Referencia visual de la propuesta</p>
    </div>
  </div>
</section>
