---
import barber from "@data/barber.json";
import { buildWhatsAppLink } from "@lib/whatsapp";
---
<div class="fixed inset-x-0 bottom-0 z-50 border-t border-white/10 bg-black/95 p-3 backdrop-blur md:hidden">
  <div class="mx-auto flex max-w-md gap-2"><a class="flex-1 bg-cyan-300 px-4 py-3 text-center text-sm font-extrabold text-black" href={barber.agendaAuto} target="_blank" rel="noopener noreferrer">Turnos</a><a class="flex-1 border border-white/20 px-4 py-3 text-center text-sm font-bold" href={buildWhatsAppLink(barber.whatsapp, barber.mensajes.consulta)} target="_blank" rel="noopener noreferrer">WhatsApp</a></div>
</div>
