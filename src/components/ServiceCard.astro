---
import { buildBookingMessage, formatUYU, getSafeWhatsAppHref, isExternalHref } from "@lib/whatsapp";
import barber from "@data/barber.json";
import type { Servicio } from "@lib/types";

type Props = {
  service: Servicio;
  brand?: string;
  whatsapp?: string;
};

const { service, brand = barber.nombre, whatsapp = barber.whatsapp } = Astro.props as Props;
const message = buildBookingMessage(barber.mensajes.whatsappBase, service.nombre);
const href = getSafeWhatsAppHref(whatsapp, message, barber.whatsappEsPlaceholder);
const hrefIsExternal = isExternalHref(href);
const durationLabel = service.duracion ? `${service.duracion} min` : "Duración a coordinar";
const priceLabel = service.precio !== null ? formatUYU(service.precio) : (service.detallePrecio ?? "Consultar");
---

<article class="group overflow-hidden border border-white/10 bg-[#10100f] transition duration-300 hover:-translate-y-1 hover:border-stone-500/50">
  {service.imagen ? (
    <div class="relative overflow-hidden">
      <img src={service.imagen} alt={service.alt ?? service.nombre} class="h-52 w-full object-cover grayscale-[25%] transition duration-700 group-hover:scale-[1.03] group-hover:grayscale-0 sm:h-60" loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-gradient-to-t from-[#10100f] via-transparent to-transparent"></div>
    </div>
  ) : (
    <div class="h-44 w-full bg-gradient-to-b from-white/5 to-black/20"></div>
  )}

  <div class="p-5 sm:p-6">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <h3 class="text-lg font-semibold text-stone-50">{service.nombre}</h3>
          {service.popular ? (
            <span class="border border-amber-200/30 bg-amber-100/5 px-2 py-0.5 text-[9px] font-bold uppercase tracking-[.12em] text-amber-100">Elegido</span>
          ) : null}
        </div>
        <p class="mt-2 text-sm leading-relaxed text-stone-400">{service.descripcion}</p>
      </div>

      <div class="shrink-0 text-right">
        <div class="text-xs text-stone-500">{durationLabel}</div>
        <div class="mt-1 max-w-36 text-base font-semibold text-stone-100">{priceLabel}</div>
      </div>
    </div>

    <div class="mt-5 border-t border-white/10 pt-4">
      <a class="inline-flex items-center text-xs font-bold uppercase tracking-[.12em] text-stone-200 transition hover:text-amber-100" href={href} target={hrefIsExternal ? "_blank" : undefined} rel={hrefIsExternal ? "noopener noreferrer" : undefined}>
        {barber.whatsappEsPlaceholder ? "Ver intención de reserva" : "Consultar este servicio"} <span aria-hidden="true" class="ml-2">↗</span>
      </a>
    </div>
  </div>
</article>
