---
import barber from "@data/barber.json";
import { buildWhatsAppLink, formatUYU } from "@lib/whatsapp";
import type { Servicio } from "@lib/types";
const { service } = Astro.props as { service: Servicio };
const message = `Hola, quiero consultar por el servicio ${service.nombre} de Techno Barber.`;
---
<article class="group grid overflow-hidden border-t border-white/15 py-5 sm:grid-cols-[110px_1fr_auto] sm:items-center sm:gap-6">
  <div class="relative hidden h-24 overflow-hidden sm:block"><img src={service.imagen} alt="Referencia visual conceptual" class="h-full w-full object-cover grayscale transition duration-500 group-hover:scale-105 group-hover:grayscale-0"/><span class="absolute bottom-1 left-1 bg-black/75 px-1 text-[7px] uppercase">Referencia visual</span></div>
  <div><div class="flex items-center gap-3"><h3 class="text-xl font-bold">{service.nombre}</h3>{service.destacado && <span class="text-[9px] font-bold uppercase tracking-wider text-cyan-300">Destacado</span>}</div><p class="mt-1 text-sm text-zinc-400">{service.descripcion}</p><p class="mt-2 text-xs text-zinc-500">{service.duracion} min</p></div>
  <div class="mt-4 flex items-center justify-between gap-5 sm:mt-0 sm:block sm:text-right"><strong class="text-xl">{formatUYU(service.precio)}</strong><div class="mt-2 flex gap-3 text-xs font-bold"><a href={barber.agendaAuto} target="_blank" rel="noopener noreferrer" class="text-cyan-300">Agenda ↗</a><a href={buildWhatsAppLink(barber.whatsapp, message)} target="_blank" rel="noopener noreferrer">Consultar</a></div></div>
</article>
