---
import "@styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import StickyCTA from "@components/StickyCTA.astro";
import barber from "@data/barber.json";
import SiteBackground from "@components/SiteBackground.astro";

type Props = {
  title: string;
  description: string;
  ogImage?: string; // opcional: override por página
};

const { title, description, ogImage } = Astro.props;
const url = new URL(Astro.request.url);
const canonical = Astro.site ? new URL(url.pathname, Astro.site).toString() : undefined;

// OG por defecto desde data
const og = ogImage ?? barber?.media?.og ?? "/images/og-cover.png";
const ogUrl = Astro.site ? new URL(og, Astro.site).toString() : og;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogUrl} />
    <meta property="og:site_name" content={barber.nombre} />
    <meta property="og:locale" content="es_UY" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="theme-color" content="#07090B" />
  </head>

  <body class="text-zinc-100">
     <SiteBackground />

    <Header currentPath={url.pathname} />

    <main id="contenido" class="mx-auto w-full max-w-7xl px-4 pb-24 pt-[72px] sm:px-6 lg:px-8">
      <slot />
    </main>

    <Footer />
    <StickyCTA />
  </body>
</html>
